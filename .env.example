# Скопируйте этот файл в .env и подставьте свои значения.
# Настоящий .env не публикуют.
# Список переменных совпадает с рабочим .env проекта.

PINECONE_API_KEY=
PINECONE_INDEX_NAME=vpg05-case-1-a-conversational
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
HAYSTACK_PINECONE_INDEX=vpg07-search-your-data

# Опционально для hay_v2_bot, если индекс создаётся с нуля:
# HAYSTACK_PINECONE_NAMESPACE=default
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
